API_PORT=3000
# API port used by the Node API and by the Angular dev proxy (proxy reads .env via dotenv). If 3000 is already in use, set API_PORT to another port (e.g. 3001).
WEB_PORT=4200
# Optional: Angular dev server port. If 4200 is already in use, set WEB_PORT to another port (e.g. 4201).
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=postgres
PGUSER=KasagalaD
PGPASSWORD=YOUR_DATABASE_PASSWORD
PGSSL=false
PGSCHEMA=DevOps_SF_Summary
CORS_ORIGIN=http://localhost:4200
AZURE_DEVOPS_ORGANIZATION=your-organization
AZURE_DEVOPS_PROJECT=your-project
AZURE_DEVOPS_PAT=replace-with-your-azure-devops-pat

#AUTH_SEED_PASSWORD=replace-with-an-initial-password
