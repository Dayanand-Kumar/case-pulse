API_PORT=3000
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=replace-with-your-local-password
PGSSL=false
PGSCHEMA=DevOps_SF_Summary
CORS_ORIGIN=http://localhost:4200
AZURE_DEVOPS_ORGANIZATION=your-organization
AZURE_DEVOPS_PROJECT=your-project
AZURE_DEVOPS_PAT=replace-with-your-azure-devops-pat

# Optional initial passwords for the seeded users (dayanand, madala, tuta). If unset, random one-time passwords are printed in the API console on first start.
AUTH_SEED_PASSWORD=replace-with-an-initial-password
