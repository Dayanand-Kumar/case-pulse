{
  "name": "case-pulse",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "api": "node backend/server.js",
    "dev": "concurrently -k \"npm:api\" \"npm:start\"",
